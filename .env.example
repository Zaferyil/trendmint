# Server-side only — these are read by the backend proxy (Netlify Function or
# `npm run dev:api`). Do NOT prefix them with VITE_: anything VITE_* is inlined
# into the browser bundle and would leak the key publicly.

ETSY_API_KEY=
ANTHROPIC_API_KEY=

# Optional: override the Claude model used for design generation.
# CLAUDE_MODEL=claude-sonnet-5

# Optional: point the frontend at a proxy on another origin.
# VITE_API_BASE=/api
