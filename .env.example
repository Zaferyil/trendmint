# Server-side only — these are read by the backend proxy (Netlify Function or
# `npm run dev:api`). Do NOT prefix them with VITE_: anything VITE_* is inlined
# into the browser bundle and would leak the key publicly.

# Etsy v3 wants both values: the proxy joins them as "keystring:shared_secret"
# in the x-api-key header, which is what the API expects.
ETSY_API_KEY=
ETSY_SHARED_SECRET=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Signs the session cookie. Required — without it sign-in returns 503 and the
# whole app stays locked. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it signs everyone out, which is also how you revoke every session.
SESSION_SECRET=

# The first admin, created only while the user store is empty. The account is
# flagged to change this password at first sign-in, so treat it as a one-time
# handover value and clear these two once you are in.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# ADMIN_NAME=Admin

# Optional: override the Claude model used for design generation.
# CLAUDE_MODEL=claude-sonnet-5

# Optional: image model and quality. gpt-image-1 supports transparent
# backgrounds; dall-e-3 works too but always paints a background.
# OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_IMAGE_QUALITY=low

# Optional: point the frontend at a proxy on another origin.
# VITE_API_BASE=/api
